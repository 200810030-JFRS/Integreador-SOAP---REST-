<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="urn:CuentaBancaria"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             targetNamespace="urn:CuentaBancaria"
             name="CuentaBancaria">
  <types>
    <xsd:schema targetNamespace="urn:CuentaBancaria" elementFormDefault="qualified">
      <xsd:element name="ConsultarSaldo"><xsd:complexType><xsd:sequence>
        <xsd:element name="numeroCuenta" type="xsd:string"/>
      </xsd:sequence></xsd:complexType></xsd:element>
      <xsd:element name="ConsultarSaldoResponse"><xsd:complexType><xsd:sequence><xsd:element name="ConsultarSaldoResult" type="xsd:decimal"/></xsd:sequence></xsd:complexType></xsd:element>
      <xsd:element name="Depositar"><xsd:complexType><xsd:sequence>
        <xsd:element name="numeroCuenta" type="xsd:string"/>
        <xsd:element name="monto" type="xsd:decimal"/>
      </xsd:sequence></xsd:complexType></xsd:element>
      <xsd:element name="DepositarResponse"><xsd:complexType><xsd:sequence><xsd:element name="DepositarResult" type="xsd:decimal"/></xsd:sequence></xsd:complexType></xsd:element>
      <xsd:element name="Retirar"><xsd:complexType><xsd:sequence>
        <xsd:element name="numeroCuenta" type="xsd:string"/>
        <xsd:element name="monto" type="xsd:decimal"/>
      </xsd:sequence></xsd:complexType></xsd:element>
      <xsd:element name="RetirarResponse"><xsd:complexType><xsd:sequence><xsd:element name="RetirarResult" type="xsd:decimal"/></xsd:sequence></xsd:complexType></xsd:element>
    </xsd:schema>
  </types>
  <message name="ConsultarSaldoRequest"><part name="parameters" element="tns:ConsultarSaldo"/></message>
  <message name="ConsultarSaldoResponse"><part name="parameters" element="tns:ConsultarSaldoResponse"/></message>
  <message name="DepositarRequest"><part name="parameters" element="tns:Depositar"/></message>
  <message name="DepositarResponse"><part name="parameters" element="tns:DepositarResponse"/></message>
  <message name="RetirarRequest"><part name="parameters" element="tns:Retirar"/></message>
  <message name="RetirarResponse"><part name="parameters" element="tns:RetirarResponse"/></message>
  <portType name="CuentaBancariaPortType">
    <operation name="ConsultarSaldo"><input message="tns:ConsultarSaldoRequest"/><output message="tns:ConsultarSaldoResponse"/></operation>
    <operation name="Depositar"><input message="tns:DepositarRequest"/><output message="tns:DepositarResponse"/></operation>
    <operation name="Retirar"><input message="tns:RetirarRequest"/><output message="tns:RetirarResponse"/></operation>
  </portType>
  <binding name="CuentaBancariaSoapBinding" type="tns:CuentaBancariaPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="ConsultarSaldo">
      <soap:operation soapAction="urn:CuentaBancaria/ConsultarSaldo" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="Depositar">
      <soap:operation soapAction="urn:CuentaBancaria/Depositar" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="Retirar">
      <soap:operation soapAction="urn:CuentaBancaria/Retirar" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>
  <service name="CuentaBancariaService">
    <port name="CuentaBancariaSoapPort" binding="tns:CuentaBancariaSoapBinding">
      <soap:address location="http://localhost:8000/"/>
    </port>
  </service>
</definitions>
